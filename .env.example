# Print-on-Demand Fulfillment (Prodigi API)
PRODIGI_API_KEY=your_prodigi_api_key_here
PRODIGI_ENV=sandbox # or 'live'

# Image Generation & Mockups (NVIDIA NIM / Build API)
# Free-tier key available at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Social & Marketplace Automation (Optional)
# PINTEREST_ACCESS_TOKEN=your_pinterest_token_here
# ETSY_API_KEY=your_etsy_api_key_here
