<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hopscotchmaps.shoprun</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/fuat.deligoz/code/playground-map/studio/ops/shop_run.sh</string>
  </array>

  <!-- Monday and Thursday, 13:00 local time. Weekday 1 = Monday, 4 = Thursday. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>13</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>13</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <!-- If the Mac was asleep at the fire time, run once on wake. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/fuat.deligoz/code/playground-map/temp_dir/shop-run/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/fuat.deligoz/code/playground-map/temp_dir/shop-run/launchd.err</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
